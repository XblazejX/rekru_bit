# ==========================================
# Bit2Meet - Konfiguracja środowiska
# ==========================================

# Aplikacja
PROJECT_NAME=Bit2Meet
ENVIRONMENT=development
DEBUG=True
# Szczegolowe logi SQL; zostaw False, bo parametry zapytan moga zawierac hashe.
SQL_ECHO=False

# Baza danych PostgreSQL
POSTGRES_USER=bit2meet_user
# Hasło lokalnej bazy. Jeśli je zmienisz, wpisz to samo hasło w DATABASE_URL poniżej.
POSTGRES_PASSWORD=bit2meet_password
POSTGRES_DB=bit2meet_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Adres bazy dla API; hasło musi być identyczne jak w POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://bit2meet_user:bit2meet_password@db:5432/bit2meet_db

# Bezpieczeństwo i JWT
# Własny .env: zmień SECRET_KEY na długi losowy sekret (minimum 32 znaki).
# Nie udostępniaj tej wartości ani nie zapisuj prawdziwych sekretów w .env.example.
SECRET_KEY=bit2meet-super-secret-jwt-key-change-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_CODE_EXPIRE_MINUTES=15
RESET_CODE_EXPIRE_MINUTES=15

# Poczta: EMAIL_MODE=mock nie wymaga konfiguracji konta; kody pojawią się w logach API.
# Aby wysyłać prawdziwe wiadomości, ustaw EMAIL_MODE=smtp i uzupełnij dane SMTP poniżej.
EMAIL_MODE=mock
# Gmail: smtp.gmail.com, port 587 (STARTTLS). Inny dostawca może wymagać innych wartości.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Wpisz pełny adres skrzynki nadawczej, np. nazwa@gmail.com.
SMTP_USER=bit2meet.rekrutacja@gmail.com
# Wpisz hasło aplikacji dostawcy poczty, bez spacji. Nie używaj zwykłego hasła do konta.
SMTP_PASSWORD=
# Zwykle ten sam adres co SMTP_USER.
SMTP_FROM=bit2meet.rekrutacja@gmail.com
SMTP_TLS=True

# CORS i adresy URL
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Frontend (Vite)
VITE_API_BASE_URL=/api

#ustawic SECRET_KEY oraz SMTP_PASSWORD na rekrutacji i EMAIL_MODE=smtp